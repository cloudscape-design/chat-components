exports[`Style API mixins of avatar match the snapshot > avatar 1`] = `
"// GENERATED from the avatar Style API docs — do not edit.
@use '@cloudscape-design/component-toolkit/internal/style-api/slot-mixins' as slot-mixins;

@mixin root(
  $border-color: null,
  $border-width: null,
  $focus-ring-color: null,
  $focus-ring-width: null,
  $focus-ring-radius: null,
  $background: null,
  $color: null,
  $border-radius: null,
  $border-start-start-radius: null,
  $border-start-end-radius: null,
  $border-end-start-radius: null,
  $border-end-end-radius: null,
  $box-shadow: null
) {
  @include slot-mixins.apply(
    'avatar.root',
    $tokens: (
      'border-color': $border-color,
      'border-width': $border-width,
      'focus-ring-color': $focus-ring-color,
      'focus-ring-width': $focus-ring-width,
      'focus-ring-radius': $focus-ring-radius,
    ),
    $properties: (
      'background': $background,
      'color': $color,
      'border-radius': $border-radius,
      'border-start-start-radius': $border-start-start-radius,
      'border-start-end-radius': $border-start-end-radius,
      'border-end-start-radius': $border-end-start-radius,
      'border-end-end-radius': $border-end-end-radius,
      'box-shadow': $box-shadow,
    ),
  );
}
"
`;

